generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                   @id @default(cuid())
  clerkId                 String                   @unique
  email                   String                   @unique
  firstName               String?
  lastName                String?
  phone                   String?
  country                 String?
  stripeCustomerId        String?                  @unique
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  kycStatus               KYCLevel                 @default(NONE)
  isDemoUser              Boolean                  @default(false)
  role                    UserRole                 @default(USER)
  tokenizerViewMode       String                   @default("post")
  walletAddress           String?                  @unique
  borrowPositions         BorrowPosition[]
  cryptoPayments          CryptoPayment[]
  holdings                Holding[]
  kycVerification         KYCVerification?
  paymentMethods          PaymentMethod[]
  rentDistributions       RentDistribution[]
  tokenizationSubmissions TokenizationSubmission[]
  transactions            Transaction[]
  vaultAccount            VaultAccount?
  activityEvents          InvestorActivityEvent[]
  engagementStatus        InvestorEngagementStatus?
  notifications           Notification[]
  investorProfile         InvestorProfile?
  allowlistEntries        InvestorAllowlist[]        @relation("AllowlistUser")
  addedAllowlistEntries   InvestorAllowlist[]        @relation("AllowlistAddedBy")
  investorStatements      InvestorStatement[]
  verifiedFields          VerifiedField[]

  @@index([clerkId])
  @@index([email])
  @@index([stripeCustomerId])
  @@index([role])
}

model KYCVerification {
  id                 String    @id @default(cuid())
  userId             String    @unique
  status             KYCStatus @default(PENDING)
  level              KYCLevel  @default(NONE)
  documentType       String?
  documentNumber     String?
  documentCountry    String?
  verificationDate   DateTime?
  expiryDate         DateTime?
  providerRef        String?
  providerData       Json?
  rejectionReason    String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  sumsubApplicantId  String?   @unique
  sumsubExternalId   String?
  sumsubLevelName    String?
  sumsubReviewResult Json?
  sumsubReviewStatus String?
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([sumsubApplicantId])
}

model Property {
  id               String         @id @default(cuid())
  name             String
  description      String?
  address          String
  city             String
  state            String
  country          String
  zipCode          String?
  propertyType     PropertyType
  status           PropertyStatus @default(DRAFT)
  totalValue       Decimal        @db.Decimal(18, 2)
  tokenPrice       Decimal        @db.Decimal(18, 6)
  totalTokens      Int
  availableTokens  Int
  annualYield      Decimal        @db.Decimal(5, 2)
  monthlyRent      Decimal?       @db.Decimal(18, 2)
  imageUrl         String?
  images           String[]
  documents        String[]
  latitude         Decimal?       @db.Decimal(10, 8)
  longitude        Decimal?       @db.Decimal(11, 8)
  squareFeet       Int?
  bedrooms         Int?
  bathrooms        Decimal?       @db.Decimal(3, 1)
  yearBuilt        Int?
  fundingDeadline  DateTime?
  fundingStartDate DateTime?
  managerId        String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  isListable       Boolean        @default(false)
  isMinted         Boolean        @default(false)
  isPaused         Boolean        @default(false)
  mintTxHash       String?
  mintedAt         DateTime?
  hasParcoStays    Boolean        @default(false)
  capabilities     Json           @default("{}")
  ownerId          String?
  holdings              Holding[]
  rentPayments          RentPayment[]
  token                 Token?
  complianceRequirements ComplianceRequirement[]
  activityEvents        InvestorActivityEvent[]
  allowlistEntries      InvestorAllowlist[]
  transferPolicy        TransferPolicy?
  onchainDeployment     OnchainDeployment?
  capTableSnapshots     CapTableSnapshot[]
  investorStatements    InvestorStatement[]

  @@index([status])
  @@index([propertyType])
  @@index([city, state])
  @@index([isPaused])
  @@index([isListable])
}

model Token {
  id                String    @id @default(cuid())
  propertyId        String    @unique
  contractAddress   String?   @unique
  tokenId           String?
  chainId           Int       @default(137)
  standard          String    @default("ERC1155")
  totalSupply       Int
  circulatingSupply Int       @default(0)
  metadata          Json?
  deployedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  holdings          Holding[]
  property          Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([contractAddress])
  @@index([chainId])
}

model Holding {
  id                 String    @id @default(cuid())
  userId             String
  propertyId         String
  tokenId            String
  quantity           Int
  averageCost        Decimal   @db.Decimal(18, 6)
  totalInvested      Decimal   @db.Decimal(18, 2)
  rentEarned         Decimal   @default(0) @db.Decimal(18, 2)
  lastRentDate       DateTime?
  demoLockedQuantity Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  property           Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  token              Token     @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
  @@index([tokenId])
}

model VaultAccount {
  id              String           @id @default(cuid())
  userId          String           @unique
  walletAddress   String?          @unique
  custodianRef    String?
  usdcBalance     Decimal          @default(0) @db.Decimal(18, 6)
  lockedBalance   Decimal          @default(0) @db.Decimal(18, 6)
  totalDeposited  Decimal          @default(0) @db.Decimal(18, 2)
  totalWithdrawn  Decimal          @default(0) @db.Decimal(18, 2)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  totalEarned     Decimal          @default(0) @db.Decimal(18, 6)
  demoBtcBalance   Decimal         @default(0) @db.Decimal(18, 6)
  demoParcoBalance Decimal         @default(0) @db.Decimal(18, 6)
  demoUsdcBalance  Decimal         @default(0) @db.Decimal(18, 6)
  demoInitialized  Boolean         @default(false)
  borrowPositions BorrowPosition[]
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([walletAddress])
}

model BorrowPosition {
  id                   String             @id @default(cuid())
  userId               String
  vaultAccountId       String
  principal            Decimal            @db.Decimal(18, 2)
  interestRate         Decimal            @db.Decimal(5, 4)
  accruedInterest      Decimal            @default(0) @db.Decimal(18, 2)
  collateralValue      Decimal            @db.Decimal(18, 2)
  collateralRatio      Decimal            @db.Decimal(5, 4)
  liquidationThreshold Decimal            @default(0.75) @db.Decimal(5, 4)
  status               BorrowStatus       @default(ACTIVE)
  borrowedAt           DateTime           @default(now())
  dueDate              DateTime?
  repaidAt             DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  lastInterestUpdate   DateTime           @default(now())
  stripePayoutId       String?
  txHash               String?
  collaterals          BorrowCollateral[]
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  vaultAccount         VaultAccount       @relation(fields: [vaultAccountId], references: [id], onDelete: Cascade)
  repayments           BorrowRepayment[]

  @@index([userId])
  @@index([vaultAccountId])
  @@index([status])
  @@index([stripePayoutId])
}

model BorrowCollateral {
  id               String         @id @default(cuid())
  borrowPositionId String
  propertyId       String
  tokenId          Int
  amount           Int
  valueAtLock      Decimal        @db.Decimal(18, 2)
  currentValue     Decimal        @db.Decimal(18, 2)
  lockedAt         DateTime       @default(now())
  unlockedAt       DateTime?
  txHashLock       String?
  txHashUnlock     String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  borrowPosition   BorrowPosition @relation(fields: [borrowPositionId], references: [id], onDelete: Cascade)

  @@index([borrowPositionId])
  @@index([propertyId])
  @@index([tokenId])
}

model BorrowRepayment {
  id                    String         @id @default(cuid())
  borrowPositionId      String
  principalPaid         Decimal        @db.Decimal(18, 2)
  interestPaid          Decimal        @db.Decimal(18, 2)
  totalPaid             Decimal        @db.Decimal(18, 2)
  paymentMethodType     String
  stripePaymentIntentId String?
  txHash                String?
  paidAt                DateTime       @default(now())
  createdAt             DateTime       @default(now())
  borrowPosition        BorrowPosition @relation(fields: [borrowPositionId], references: [id], onDelete: Cascade)

  @@index([borrowPositionId])
  @@index([stripePaymentIntentId])
}

model Transaction {
  id            String            @id @default(cuid())
  userId        String
  type          TransactionType
  status        TransactionStatus @default(PENDING)
  amount        Decimal           @db.Decimal(18, 6)
  currency      String            @default("USDC")
  propertyId    String?
  tokenQuantity Int?
  tokenPrice    Decimal?          @db.Decimal(18, 6)
  fee           Decimal?          @db.Decimal(18, 6)
  txHash        String?
  blockNumber   Int?
  chainId       Int?
  reference     String?
  description   String?
  metadata      Json?
  failureReason String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  completedAt   DateTime?
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([propertyId])
  @@index([txHash])
  @@index([createdAt])
}

model RentPayment {
  id             String             @id @default(cuid())
  propertyId     String
  periodStart    DateTime
  periodEnd      DateTime
  grossAmount    Decimal            @db.Decimal(18, 2)
  netAmount      Decimal            @db.Decimal(18, 2)
  managementFee  Decimal            @db.Decimal(18, 2)
  perTokenAmount Decimal            @db.Decimal(18, 6)
  distributedAt  DateTime?
  status         TransactionStatus  @default(PENDING)
  txHash         String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  distributions  RentDistribution[]
  property       Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([periodStart, periodEnd])
  @@index([status])
}

model PaymentMethod {
  id                    String             @id @default(cuid())
  userId                String
  stripePaymentMethodId String             @unique
  stripeCustomerId      String
  type                  PaymentMethodType
  isDefault             Boolean            @default(false)
  cardBrand             String?
  cardLast4             String?
  cardExpMonth          Int?
  cardExpYear           Int?
  bankName              String?
  bankLast4             String?
  bankAccountType       String?
  bankStatus            BankAccountStatus?
  nickname              String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([stripePaymentMethodId])
  @@index([stripeCustomerId])
}

model CryptoPayment {
  id                 String              @id @default(cuid())
  userId             String
  coinbaseChargeId   String              @unique
  coinbaseChargeCode String              @unique
  amount             Decimal             @db.Decimal(18, 2)
  currency           String              @default("USD")
  cryptoCurrency     CryptoCurrency?
  cryptoAmount       Decimal?            @db.Decimal(28, 18)
  status             CryptoPaymentStatus @default(PENDING)
  hostedUrl          String?
  expiresAt          DateTime?
  confirmedAt        DateTime?
  txHash             String?
  metadata           Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([coinbaseChargeId])
  @@index([status])
  @@index([createdAt])
}

model RentDistribution {
  id               String      @id @default(cuid())
  rentPaymentId    String
  userId           String
  holdingId        String
  propertyId       String
  tokensHeld       Int
  totalTokens      Int
  ownershipPercent Decimal     @db.Decimal(10, 6)
  grossAmount      Decimal     @db.Decimal(18, 6)
  interestDeducted Decimal     @default(0) @db.Decimal(18, 6)
  netAmount        Decimal     @db.Decimal(18, 6)
  distributedAt    DateTime    @default(now())
  txHash           String?
  createdAt        DateTime    @default(now())
  rentPayment      RentPayment @relation(fields: [rentPaymentId], references: [id], onDelete: Cascade)
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([rentPaymentId])
  @@index([userId])
  @@index([propertyId])
  @@index([distributedAt])
}

model DistributionRun {
  id                    String    @id @default(cuid())
  runType               String    @default("SCHEDULED")
  triggeredBy           String?
  propertiesProcessed   Int       @default(0)
  rentPaymentsProcessed Int       @default(0)
  holdersDistributed    Int       @default(0)
  totalGrossDistributed Decimal   @default(0) @db.Decimal(18, 6)
  totalInterestDeducted Decimal   @default(0) @db.Decimal(18, 6)
  totalNetDistributed   Decimal   @default(0) @db.Decimal(18, 6)
  status                String    @default("RUNNING")
  errorMessage          String?
  startedAt             DateTime  @default(now())
  completedAt           DateTime?

  @@index([status])
  @@index([startedAt])
}

model Proposal {
  id             String         @id @default(cuid())
  title          String
  description    String
  proposerId     String
  status         ProposalStatus @default(DRAFT)
  votingStartsAt DateTime?
  votingEndsAt   DateTime?
  forVotes       Int            @default(0)
  againstVotes   Int            @default(0)
  abstainVotes   Int            @default(0)
  quorumRequired Int            @default(100)
  passThreshold  Decimal        @default(50.00) @db.Decimal(5, 2)
  executedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  votes          Vote[]

  @@index([status])
  @@index([proposerId])
  @@index([votingEndsAt])
}

model Vote {
  id          String     @id @default(cuid())
  proposalId  String
  userId      String
  choice      VoteChoice
  votingPower Int        @default(1)
  comment     String?
  createdAt   DateTime   @default(now())
  proposal    Proposal   @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([proposalId, userId])
  @@index([proposalId])
  @@index([userId])
}

model TokenizationSubmission {
  id                  String             @id @default(cuid())
  tokenizerId         String
  status              TokenizationStatus @default(DRAFT)
  propertyName        String
  propertyAddress     String
  propertyCity        String
  propertyState       String
  propertyCountry     String
  propertyZipCode     String?
  propertyType        PropertyType
  totalValue          Decimal            @db.Decimal(18, 2)
  tokenPrice          Decimal            @db.Decimal(18, 6)
  totalTokens         Int
  annualYield         Decimal            @db.Decimal(5, 2)
  monthlyRent         Decimal?           @db.Decimal(18, 2)
  description         String?
  imageUrl            String?
  images              String[]
  documents           String[]
  squareFeet          Int?
  bedrooms            Int?
  bathrooms           Decimal?           @db.Decimal(3, 1)
  yearBuilt           Int?
  ownershipProof      String?
  legalDocuments      String[]
  financialStatements String[]
  reviewedById        String?
  reviewNotes         String?
  rejectionReason     String?
  submittedAt         DateTime?
  reviewedAt          DateTime?
  approvedAt          DateTime?
  publishedAt         DateTime?
  propertyId          String?            @unique
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  tokenizer           User               @relation(fields: [tokenizerId], references: [id], onDelete: Cascade)
  issuanceCase        IssuanceCase?

  @@index([tokenizerId])
  @@index([status])
  @@index([createdAt])
}

model IssuanceCase {
  id                   String              @id @default(cuid())
  submissionId         String              @unique
  status               IssuanceCaseStatus  @default(DRAFT)
  eligibilityStatus    EligibilityStatus   @default(PENDING)
  extractionScore      Int                 @default(0)
  extractionQualityStatus String           @default("PENDING")
  notes                String?
  track                IssuanceTrack       @default(SERIES_LLC)
  targetState          USState             @default(OTHER)
  maxPropertyPriceCents Int?
  eligibilityNotes     String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  submission           TokenizationSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  documents            IssuanceDocument[]
  eligibilityChecks    EligibilityCheck[]
  checklistItems       ChecklistItem[]
  approvalTasks        ApprovalTask[]
  complianceRequirements ComplianceRequirement[]
  extractedFields      ExtractedField[]
  verifiedFields       VerifiedField[]
  extractionRuns       ExtractionRun[]
  offeringPacket       OfferingPacket?

  @@index([status])
  @@index([eligibilityStatus])
  @@index([track])
}

model IssuanceDocument {
  id              String           @id @default(cuid())
  caseId          String
  type            IssuanceDocType
  name            String
  url             String
  mimeType        String?
  sizeBytes       Int?
  sha256          String?
  textContent     String?
  textStatus      String           @default("PENDING")
  lastProcessedAt DateTime?
  processingError String?
  createdAt       DateTime         @default(now())
  case            IssuanceCase     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  extractedFields ExtractedField[]

  @@index([caseId])
}

model ExtractedField {
  id               String            @id @default(cuid())
  caseId           String
  key              String
  value            String
  confidence       Float?
  sourceDocumentId String?
  extractionRunId  String?
  metadata         Json?
  createdAt        DateTime          @default(now())
  case             IssuanceCase      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  sourceDocument   IssuanceDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  extractionRun    ExtractionRun?    @relation(fields: [extractionRunId], references: [id], onDelete: SetNull)
  verifiedFields   VerifiedField[]

  @@index([caseId, key])
}

model VerifiedField {
  id                     String          @id @default(cuid())
  caseId                 String
  key                    String
  value                  String
  verifiedByUserId       String?
  verifiedAt             DateTime?
  sourceExtractedFieldId String?
  case                   IssuanceCase    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  verifiedByUser         User?           @relation(fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  sourceExtractedField   ExtractedField? @relation(fields: [sourceExtractedFieldId], references: [id], onDelete: SetNull)

  @@unique([caseId, key])
}

model ExtractionRun {
  id              String           @id @default(cuid())
  caseId          String
  status          String
  modelName       String?
  tokenUsage      Json?
  lastError       String?
  startedAt       DateTime
  finishedAt      DateTime?
  createdAt       DateTime         @default(now())
  case            IssuanceCase     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  extractedFields ExtractedField[]

  @@index([caseId])
}

model IssuanceTemplate {
  id          String        @id @default(cuid())
  track       IssuanceTrack @unique
  name        String
  description String?
  rules       Json
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model StateSeriesLlcProfile {
  id        String   @id @default(cuid())
  state     USState  @unique
  isEnabled Boolean  @default(false)
  notes     String?
  rules     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EligibilityCheck {
  id        String            @id @default(cuid())
  caseId    String
  key       String
  status    EligibilityStatus
  details   String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  case      IssuanceCase      @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, key])
  @@index([caseId])
}

model ChecklistItem {
  id        String          @id @default(cuid())
  caseId    String
  key       String
  label     String
  ownerRole ApprovalRole
  status    ChecklistStatus @default(PENDING)
  notes     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  case      IssuanceCase    @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, key])
  @@index([caseId])
}

model ApprovalTask {
  id        String          @id @default(cuid())
  caseId    String
  role      ApprovalRole
  status    ChecklistStatus @default(PENDING)
  notes     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  case      IssuanceCase    @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, role])
  @@index([caseId])
}

enum ApprovalRole {
  OPS
  LEGAL
  ACCOUNTING
  COMPLIANCE
}

enum ChecklistStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

enum IssuanceTrack {
  SERIES_LLC
  REG_CF
  REG_A
  REG_D
}

enum USState {
  NV
  FL
  WY
  OTHER
}

enum IssuanceCaseStatus {
  DRAFT
  INTAKE_COMPLETE
  EXTRACTION_RUNNING
  EXTRACTION_COMPLETE
  REVIEW_READY
  APPROVED
  MINT_READY
  MINTED
  LIVE
  REJECTED
}

enum IssuanceDocType {
  OWNERSHIP
  LEGAL
  FINANCIAL
  PROPERTY
  IDENTITY
  OTHER
}

enum EligibilityStatus {
  PENDING
  PASS
  FAIL
  NEEDS_REVIEW
}

model CompliancePackTemplate {
  id        String        @id @default(cuid())
  track     IssuanceTrack @unique
  name      String
  rules     Json
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model ComplianceRequirement {
  id         String               @id @default(cuid())
  propertyId String
  caseId     String?
  key        String
  label      String
  cadence    String
  status     String               @default("PENDING")
  dueAt      DateTime?
  notes      String?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  property   Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  case       IssuanceCase?        @relation(fields: [caseId], references: [id], onDelete: SetNull)
  evidence   ComplianceEvidence[]

  @@unique([propertyId, key])
  @@index([propertyId, status, dueAt])
}

model ComplianceEvidence {
  id               String                @id @default(cuid())
  requirementId    String
  name             String
  url              String
  uploadedByUserId String?
  createdAt        DateTime              @default(now())
  requirement      ComplianceRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@index([requirementId])
}

model CapTableSnapshot {
  id           String   @id @default(cuid())
  propertyId   String
  asOf         DateTime
  totalHolders Int
  totalSupply  String
  data         Json
  createdAt    DateTime @default(now())
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([asOf])
}

model InvestorStatement {
  id            String   @id @default(cuid())
  userId        String
  propertyId    String
  periodStart   DateTime
  periodEnd     DateTime
  statementText String
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([propertyId])
  @@index([periodStart, periodEnd])
}

enum KYCLevel {
  NONE
  BASIC
  VERIFIED
  ACCREDITED
}

enum KYCStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  BUY
  SELL
  RENT_DISTRIBUTION
  BORROW
  REPAY
  INTEREST
  FEE
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum PropertyStatus {
  DRAFT
  PENDING_APPROVAL
  FUNDING
  FUNDED
  ACTIVE
  SOLD
  DELISTED
}

enum PropertyType {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
  MIXED_USE
  LAND
}

enum BorrowStatus {
  ACTIVE
  REPAID
  LIQUIDATED
  DEFAULTED
}

enum PaymentMethodType {
  CARD
  US_BANK_ACCOUNT
}

enum BankAccountStatus {
  NEW
  VALIDATED
  VERIFIED
  VERIFICATION_FAILED
  ERRORED
}

enum CryptoPaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  EXPIRED
  RESOLVED
}

enum CryptoCurrency {
  BTC
  ETH
  SOL
  USDC
  USDT
  DAI
}

enum UserRole {
  USER
  TOKENIZER
  ADMIN
}

enum TokenizationStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
  PUBLISHED
}

enum ProposalStatus {
  DRAFT
  ACTIVE
  PASSED
  REJECTED
  EXECUTED
  CANCELLED
}

enum VoteChoice {
  FOR
  AGAINST
  ABSTAIN
}

model DemoHolding {
  id             String   @id @default(cuid())
  userId         String
  propertyId     String
  propertyName   String
  quantity       Int      @default(0)
  lockedQuantity Int      @default(0)
  averageCost    Decimal  @default(0) @db.Decimal(18, 6)
  totalInvested  Decimal  @default(0) @db.Decimal(18, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
}

model DemoLendingPool {
  id        String                @id @default(cuid())
  name      String                @unique
  apy       Decimal               @db.Decimal(5, 2)
  tvl       Decimal               @default(0) @db.Decimal(18, 2)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  positions DemoLendingPosition[]
}

model DemoLendingPosition {
  id              String          @id @default(cuid())
  userId          String
  poolId          String
  depositedAmount Decimal         @default(0) @db.Decimal(18, 6)
  accruedYield    Decimal         @default(0) @db.Decimal(18, 6)
  lastAccruedAt   DateTime        @default(now())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  pool            DemoLendingPool @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@unique([userId, poolId])
  @@index([userId])
  @@index([poolId])
}

model DemoGovernanceProposal {
  id                     String               @id @default(cuid())
  title                  String
  description            String
  propertyId             String?
  estimatedCost          Decimal              @db.Decimal(18, 2)
  timelineWeeks          Int
  expectedAppreciation   Decimal              @db.Decimal(5, 2)
  status                 ProposalStatus       @default(ACTIVE)
  forVotes               Int                  @default(0)
  againstVotes           Int                  @default(0)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  votes                  DemoGovernanceVote[]

  @@index([status])
  @@index([propertyId])
}

model DemoGovernanceVote {
  id         String                 @id @default(cuid())
  proposalId String
  userId     String
  choice     VoteChoice
  createdAt  DateTime               @default(now())
  proposal   DemoGovernanceProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([proposalId, userId])
  @@index([proposalId])
  @@index([userId])
}

model DemoStayBooking {
  id                String   @id @default(cuid())
  userId            String
  propertyId        String
  checkIn           DateTime
  checkOut          DateTime
  guests            Int
  nightlyRate       Decimal  @db.Decimal(10, 2)
  cleaningFee       Decimal  @db.Decimal(10, 2)
  serviceFee        Decimal  @db.Decimal(10, 2)
  tokenHolderCredit Decimal  @db.Decimal(10, 2)
  totalAmount       Decimal  @db.Decimal(10, 2)
  tokensOwned       Int
  status            String   @default("CONFIRMED")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
  @@index([propertyId])
}

model DemoActionLog {
  id           String          @id @default(cuid())
  userId       String
  actionType   DemoActionType
  actionData   Json?
  propertyId   String?
  tokenAmount  Int?
  usdcAmount   Decimal?        @db.Decimal(18, 2)
  rewardTokens Decimal         @default(0) @db.Decimal(18, 6)
  rewardPaid   Boolean         @default(false)
  createdAt    DateTime        @default(now())
  
  @@index([userId])
  @@index([actionType])
  @@index([createdAt])
  @@index([rewardPaid])
}

enum DemoActionType {
  SIGN_UP
  BUY_TOKEN
  SELL_TOKEN
  BORROW_USDC
  REPAY_LOAN
  DEPOSIT_LENDING
  WITHDRAW_LENDING
  VOTE_GOVERNANCE
  BOOK_STAY
  COMPLETE_KYC
  TOKENIZATION_POPULATE
}

model AuditEvent {
  id        String   @id @default(cuid())
  type      String
  entityId  String?
  userId    String?
  oldValue  Json?
  newValue  Json?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([type])
  @@index([entityId])
  @@index([userId])
  @@index([createdAt])
}

model InvestorActivityEvent {
  id         String    @id @default(cuid())
  userId     String
  propertyId String?
  type       String
  metadata   Json?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([type])
  @@index([propertyId])
}

model InvestorEngagementStatus {
  id           String    @id @default(cuid())
  userId       String    @unique
  lastActiveAt DateTime?
  score        Int       @default(0)
  tags         Json?
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([score])
  @@index([lastActiveAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  message   String
  status    String   @default("UNREAD")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([createdAt])
}

enum InvestorKycStatus {
  NOT_STARTED
  PENDING
  APPROVED
  REJECTED
}

enum AccreditationStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum TransferPolicyType {
  UNRESTRICTED
  ALLOWLIST_ONLY
  ALLOWLIST_AND_LOCKUP
  REG_D_12M_LOCKUP
  CUSTOM
}

model InvestorProfile {
  id                  String              @id @default(cuid())
  userId              String              @unique
  kycStatus           InvestorKycStatus   @default(NOT_STARTED)
  accreditationStatus AccreditationStatus @default(NOT_REQUIRED)
  country             String?
  state               String?
  jurisdictionTags    Json?
  riskFlags           Json?
  lastKycCheckAt      DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InvestorAllowlist {
  id            String   @id @default(cuid())
  propertyId    String
  userId        String
  isAllowed     Boolean  @default(true)
  reason        String?
  addedByUserId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user          User     @relation("AllowlistUser", fields: [userId], references: [id], onDelete: Cascade)
  addedBy       User?    @relation("AllowlistAddedBy", fields: [addedByUserId], references: [id], onDelete: SetNull)

  @@unique([propertyId, userId])
  @@index([propertyId])
  @@index([userId])
}

model TransferPolicy {
  id                 String             @id @default(cuid())
  propertyId         String             @unique
  type               TransferPolicyType @default(ALLOWLIST_ONLY)
  lockupEndsAt       DateTime?
  maxHolders         Int?
  maxPerInvestorCents Int?
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  property           Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model OnchainDeployment {
  id               String   @id @default(cuid())
  propertyId       String   @unique
  chainId          Int
  tokenAddress     String
  registryAddress  String?
  deployedByUserId String?
  deployedAt       DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  property         Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model OfferingPacket {
  id        String   @id @default(cuid())
  caseId    String   @unique
  status    String   @default("DRAFT")
  markdown  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  case      IssuanceCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
}
