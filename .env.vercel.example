# Parco Frontend — Vercel Environment Variables
# Add these in Vercel dashboard > Project Settings > Environment Variables

# API base URL (your Render API URL)
VITE_API_BASE_URL=https://parco-api.onrender.com

# Clerk (publishable key only — safe for frontend)
VITE_CLERK_PUBLISHABLE_KEY=pk_live_...

# Stripe (publishable key only — safe for frontend)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Coinbase Commerce (checkout URL — optional)
VITE_COINBASE_COMMERCE_CHECKOUT_URL=
