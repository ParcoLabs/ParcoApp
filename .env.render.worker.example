# Parco Worker — Render Environment Variables
# Copy to Render dashboard > parco-worker > Environment

NODE_ENV=production

# Database (Neon)
DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require

# Queue (Redis)
REDIS_URL=redis://user:pass@host:6379

# Blockchain Signing (worker only)
RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
DEPLOYER_PRIVATE_KEY=0x...
SIGNER_PROVIDER=env-key

# Storage (Cloudflare R2) — needed for doc extraction
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=parco-docs
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# AI (for document extraction jobs)
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=

# Worker config
WORKER_CONCURRENCY=3
